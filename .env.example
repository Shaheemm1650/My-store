# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NOTE: No service-role key is needed. Never expose one with a NEXT_PUBLIC_ prefix.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=My Store
NEXT_PUBLIC_CURRENCY=MVR
NEXT_PUBLIC_LOCALE=en-MV

# --- Bank transfer details shown to customers (server-only) ---
BANK_NAME=Bank of Maldives
BANK_ACCOUNT_NAME=My Store Pvt Ltd
BANK_ACCOUNT_NUMBER=7700000000000
